# Echoes of the Forgotten - Backend Environment Configuration

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider Configuration
# Supported providers: groq, openrouter, offline
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
# Obtain a free key from https://console.groq.com/
# Leave empty to run in zero-cost Offline Archive Mode
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant

AI_TIMEOUT_SECONDS=15
AI_MAX_TOKENS=600

# Persistence
DATABASE_PATH=echoes.db
