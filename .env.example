# Echoes of the Forgotten - Environment Configuration
# Copy this file to backend/.env and configure your values.

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider Configuration
# Supported providers: groq, openrouter, together, offline
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
# Obtain a free key from https://console.groq.com/
# If AI_API_KEY is empty, the application automatically runs in Offline Archive Mode!
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant

# Request Limits
AI_TIMEOUT_SECONDS=15
AI_MAX_TOKENS=600

# Persistence
DATABASE_PATH=echoes.db
